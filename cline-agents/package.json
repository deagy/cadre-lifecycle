{
  "name": "@deagy/cadre-lifecycle-cline-agents-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "cline": {
    "plugins": [
      {
        "paths": [
          "./index.ts"
        ],
        "capabilities": [
          "tools"
        ]
      }
    ]
  },
  "dependencies": {
    "@cline/sdk": "0.0.65",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
